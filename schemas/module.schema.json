{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tutivar Module Contract",
  "type": "object",
  "required": ["id", "version", "status", "provides", "requires"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["planned", "experimental", "active", "deprecated"] },
    "provides": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$" } },
    "requires": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9.-]*$" } }
  }
}
