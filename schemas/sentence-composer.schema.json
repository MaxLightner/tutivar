{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tutivar Data-driven Sentence Composer Activity",
  "type": "object",
  "required": [
    "id",
    "type",
    "title",
    "description",
    "wordSets",
    "slots",
    "derivedDefaults",
    "patterns",
    "defaultPattern"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "sentence-composer"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "targetLanguage": {
      "type": "string"
    },
    "wordSets": {
      "type": "object"
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "wordSet",
          "default"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "wordSet": {
            "type": "string"
          },
          "default": {
            "type": "string"
          },
          "includeRoles": {
            "type": "array",
            "items": {
              "enum": [
                "core",
                "supplementary"
              ]
            }
          }
        }
      }
    },
    "derivedDefaults": {
      "type": "object"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "when",
          "set"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "when": {
            "type": "object"
          },
          "set": {
            "type": "object"
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "segments"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "translationSegments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    },
    "defaultPattern": {
      "type": "string"
    },
    "optionSearchThreshold": {
      "type": "integer",
      "minimum": 1
    },
    "completion": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "sentence",
        "phrases"
      ]
    }
  }
}
